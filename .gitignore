# Binaries
/server
/duelist-server
*.exe
*.exe~
*.dll
*.so
*.dylib
# Secrets: .env holds ANTHROPIC_API_KEY and admin credentials
.env
.env.*
!.env.example
# Logs
*.log

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Web (in case local gitignore is missing, though it exists)
web/node_modules
web/dist
web/dev-dist/
web/.env
web/.env.local
# Game assets never live in web/public: the Go server serves them all from
# content/assets at /assets. Kept ignored so a stray copy is never committed
# (vite would also copy it into every build).
web/public/attributes/
web/public/audio/
web/public/terrains/
web/public/models/
web/public/textures/
web/public/cards/
web/public/fonts/

gcloud

# Asset files served at /assets (see scripts/content/import_assets.sh). Too big
# for git, except the card font, which is small and has no other source.
content/assets/*
!content/assets/fonts/



# Signing key and accounts (never commit)
/data/

# Local art and downloader dumps (4+ GB); never commit
/assets/
./assets
# dev.sh pids and logs
.dev/

# make_mask: its Python environment, the masks it makes for review (the ones
# accepted are copied into content/assets), and the sample art it was tried on.
make_mask/venv/
make_mask/review/
make_mask/cards/
make_mask/__pycache__/
