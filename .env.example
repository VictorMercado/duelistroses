# Copy to .env (gitignored) and fill in. dev.sh loads it for both servers.

# Required for LLM bots
ANTHROPIC_API_KEY=
# LLM_MODEL=

# Go server (defaults shown)
# PORT=8080
# PUBLIC_URL=http://localhost:8080
# TURN_SECONDS=99
# DATA_DIR=./data
# ASSET_DIR=./content/assets
# STATIC_DIR=./web/dist
# ADMIN_USERS=
# ADMIN_NAME=admin
# ADMIN_PASSWORD=admin

# Vite dev server port used by dev.sh
# WEB_PORT=5173

# Prometheus metrics address (served apart from the public port; "off" disables)
# METRICS_ADDR=:9091

# Proxies whose X-Forwarded-For / CF-Connecting-IP name the real client: CIDRs,
# addresses, "private" (loopback, 10/8, 172.16/12, 192.168/16, fc00::/7: Traefik
# on the LAN) or "cloudflare" (Cloudflare's edge), comma-separated. Client IPs
# on error reports come from it.
# TRUSTED_PROXIES=private,cloudflare

# --- monitoring stack (docker compose) ---
# Required by docker compose: Grafana's admin password.
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ADMIN_USER=admin
# PROMETHEUS_RETENTION=30d

# Voice chat runs browser to browser; these only help the browsers find each other.
# STUN_URLS replaces the default public STUN servers (comma separated).
# STUN_URLS=stun:stun.l.google.com:19302
# Some networks (strict carriers, offices) need audio relayed through a TURN
# server, e.g. coturn with use-auth-secret. Without one, those players can't connect.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=coturn-static-auth-secret
